// Your series budget (S5, decision 014). Every series from this host passes through one of these three
// before it's sent. Grafana Cloud's free tier allows 10,000 active series for all hosts together
// (contracts/metrics.yaml). With no rules, everything is sent.
//
// Rules are Prometheus relabelling (https://grafana.com/docs/alloy/latest/reference/components/prometheus/prometheus.relabel/):
//   rule { source_labels = ["__name__"]  regex = "node_(cpu|memory)_.*"  action = "keep" }
//   rule { regex = "id"  action = "labeldrop" }
//
// Decision 014: keep what a dashboard, an SLO or an incident uses, and stay under 5,000 for all hosts.
// Before any rules: about 3,445 series from app + platform (cAdvisor 1,708, node 1,273, Traefik 223,
// app 190, serving 42). `up` is kept everywhere: one series per target, and the first thing an incident asks.

declare "host" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// CPU, memory, disk space and network: what "is the host OK?" needs.
		rule {
			source_labels = ["__name__"]
			regex         = "node_cpu_seconds_total|node_memory_(MemAvailable|MemTotal)_bytes|node_filesystem_(avail|size)_bytes|node_network_(receive|transmit)_bytes_total|up"
			action        = "keep"
		}

		// Real disks only, not the in-memory and container filesystems.
		rule {
			source_labels = ["__name__", "fstype"]
			regex         = "node_filesystem_.*;(tmpfs|devtmpfs|overlay|squashfs|nsfs|proc|sysfs|ramfs)"
			action        = "drop"
		}

		// The host's own interface, not loopback or Docker's bridges and veth pairs (one per container).
		rule {
			source_labels = ["__name__", "device"]
			regex         = "node_network_.*;(lo|docker0|br-.*|veth.*)"
			action        = "drop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "containers" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// CPU and memory per container: the dashboard's memory panel, and "which container is eating the host?".
		rule {
			source_labels = ["__name__"]
			regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes)|up"
			action        = "keep"
		}

		// cAdvisor also reports system cgroups with no container name: not containers.
		rule {
			source_labels = ["__name__", "name"]
			regex         = "container_.*;"
			action        = "drop"
		}

		// New on every deploy (the container id, the image tag): the container name stays, so a redeployed
		// container continues its own series instead of starting a new one.
		rule {
			regex  = "id|image"
			action = "labeldrop"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}

declare "services" {
	argument "forward_to" { }

	prometheus.relabel "rules" {
		forward_to = argument.forward_to.value

		// contracts/metrics.yaml's lab_* (app and serving) and Traefik's per-service requests and latency
		// (S8's canary compares serving-champion and serving-challenger with them).
		rule {
			source_labels = ["__name__"]
			regex         = "lab_.*|traefik_service_.*|up"
			action        = "keep"
		}
	}

	export "receiver" {
		value = prometheus.relabel.rules.receiver
	}
}
